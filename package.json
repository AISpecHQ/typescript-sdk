{
  "name": "@engine-spec/typescript-sdk",
  "version": "0.2.1",
  "description": "TypeScript SDK for the EngineSpec platform",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./aispec-v0": {
      "types": "./dist/aispec-v0.d.ts",
      "import": "./dist/aispec-v0.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tests/tsconfig.typecheck.json",
    "test": "npm run build && npm run typecheck && node --test",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@engine-spec/engine": "^0.2.1",
    "@iaspec/engine-adapter": "^0.2.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
