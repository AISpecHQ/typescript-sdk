{
  "name": "@iaspec/typescript-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for AISpec repositories",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tests/tsconfig.typecheck.json",
    "test": "npm run build && npm run typecheck && node --test",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@iaspec/engine": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
